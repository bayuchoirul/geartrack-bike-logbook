{
  "name": "geartrack-bike-logbook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:css": "tailwindcss -i ./src/css/input.css -o ./public/css/telemetry.css --watch",
    "build:config": "node scripts/generate-config.mjs",
    "build:css": "tailwindcss -i ./src/css/input.css -o ./public/css/telemetry.css --minify",
    "build": "npm run build:config && npm run build:css",
    "typecheck": "npm run build:config && tsc -p jsconfig.json --noEmit",
    "test": "node --test"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}